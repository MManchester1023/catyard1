{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Cat Yard window may do: save files in its own data folder, talk to the Claude API and read Wikipedia for the tablet, hide and close itself.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "http:default", "allow": [{ "url": "https://api.anthropic.com/*" }, { "url": "https://en.wikipedia.org/*" }] }
  ]
}
